# Normalize line endings in the repository to LF.
* text=auto eol=lf

# Files executed inside Linux containers / by bash must keep LF on every OS
# (core.autocrlf=true on Windows would otherwise break them).
*.sh   text eol=lf
mvnw   text eol=lf

# Windows-only scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files.
*.jar  binary
*.png  binary
*.jpg  binary
*.ico  binary
